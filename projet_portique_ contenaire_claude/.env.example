# Copier ce fichier en ".env" (jamais versionné) puis adapter.
# `npm run db:init` peut créer ce fichier automatiquement avec un mot de passe généré.

# Connexion de l'application (rôle dédié, PAS le super-utilisateur postgres)
DATABASE_URL=postgres://portique_app:CHANGER_MOI@localhost:5432/portique

# Base utilisée par les tests automatiques (elle est vidée à chaque exécution des tests !)
DATABASE_URL_TEST=postgres://portique_app:CHANGER_MOI@localhost:5432/portique_test

# Serveur HTTP local
PORT=3000
HOST=127.0.0.1

# Source des événements : SIMULATION (par défaut) ou MATERIEL (attend un pont matériel)
SOURCE_EVENEMENTS=SIMULATION
