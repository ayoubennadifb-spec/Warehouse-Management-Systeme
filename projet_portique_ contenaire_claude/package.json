{
  "name": "portique-conteneurs",
  "version": "0.1.0",
  "private": true,
  "description": "Portique miniature de manutention de conteneurs : base PostgreSQL, API locale, simulation et interface web (future base du jumeau numérique).",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "db:init": "node scripts/db-init.ts",
    "db:migrate": "node scripts/migrer.ts",
    "db:seed": "node scripts/seed-demo.ts",
    "db:reset": "node scripts/reinitialiser.ts",
    "dev": "node scripts/dev.ts",
    "build": "vite build",
    "start": "node src/server/index.ts",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "test:ui": "node tests/ui/captures.ts",
    "test:antisway": "node --test tests/antisway.test.ts",
    "test:ui:antisway": "node tests/ui/antisway.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.186.0",
    "playwright-core": "^1.63.0",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
